{
  "name": "dsh-mobile",
  "version": "0.1.0",
  "description": "掌上 dsh —— 手机端完整聊天界面（复用 dsh-palm 手机 bundle）：6 位码配对、设备信任、工作区/会话/聊天，可经公网反代访问。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "assets/theme.css",
    "assets/mobile.bundle.js",
    "assets/icon-192.png",
    "assets/icon-512.png",
    "assets/apple-touch-icon.png",
    "assets/whale.png",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src/host"
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
