{
  "name": "dsh-mobile-web",
  "version": "0.1.0",
  "description": "掌上 dsh —— DSH 的手机端完整聊天界面：6 位码配对、设备信任、工作区/会话/聊天、SSE 实时流，可经局域网或公网反代访问。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "assets/theme.css",
    "assets/mobile.bundle.js",
    "assets/icon-192.png",
    "assets/icon-512.png",
    "assets/apple-touch-icon.png",
    "assets/whale.png",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src/host"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "mobile",
    "phone",
    "remote-access",
    "pwa",
    "sse"
  ],
  "author": {
    "name": "2333someone"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2333someone/dsh-mobile.git"
  },
  "homepage": "https://github.com/2333someone/dsh-mobile#readme",
  "bugs": {
    "url": "https://github.com/2333someone/dsh-mobile/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "smoke": "node test/smoke.mjs"
  }
}
